# NetSpace IPAM backend — copy to .env and adjust.
# Every setting can also be provided as a NETSPACE_* environment variable.

NETSPACE_APP_NAME="NetSpace IPAM"
NETSPACE_DATABASE_URL="sqlite:///./netspace.db"
# NETSPACE_DATABASE_URL="postgresql+psycopg://user:pass@db:5432/netspace"

NETSPACE_LOG_LEVEL=INFO
NETSPACE_API_V1_PREFIX=/api/v1
NETSPACE_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Planning limits
NETSPACE_MAX_PAGE_SIZE=200
NETSPACE_MAX_DEPARTMENTS_PER_PLAN=512
NETSPACE_ALGORITHM_VERSION=vlsm-1.0.0

# Auth (M5). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave NETSPACE_AUTH_SECRET empty for dev (per-process random secret; tokens do
# not survive restarts). NEVER commit the real value.
NETSPACE_AUTH_SECRET=dev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-medev-secret-change-me
NETSPACE_JWT_EXPIRES_MINUTES=480
NETSPACE_MAX_REQUEST_BODY_BYTES=1048576
